# Discord
DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
# Recommended while testing: commands update instantly in one server.
# Remove/leave blank to register global commands instead.
DISCORD_GUILD_ID=YOUR_SERVER_ID

# Store
STORE_URL=https://thehudsonshop.com

# Small health server used by Railway
WEB_PORT=3000

# Persistent directory. Railway: mount a volume here and set DATA_DIR to its path.
DATA_DIR=./data
# Register guild slash commands automatically at startup.
AUTO_REGISTER_COMMANDS=true
# Only enable after enabling Server Members Intent in the Discord Developer Portal.
ENABLE_MEMBER_INTENT=false

# Optional shop integration: secrets belong in Railway Variables, never in Git.
# With this enabled, /deliver requires a HUD- order reference and performs
# the website admin's Confirm & Deliver action before assigning Discord roles.
SHOP_DELIVERY_ENABLED=false
SHOP_ADMIN_EMAIL=
SHOP_ADMIN_PASSWORD=
SHOP_SUPABASE_URL=
SHOP_SUPABASE_ANON_KEY=
